# Ticket de API Mercado Público (solicitar en api.mercadopublico.cl)
MERCADO_PUBLICO_TOKEN=

# Resend para envío de correo (https://resend.com/api-keys)
RESEND_API_KEY=

# Correo destino del radar (puede ser sergio@terceraletra.cl)
RADAR_TO_EMAIL=

# Remitente verificado en Resend (debe estar verificado el dominio)
RADAR_FROM_EMAIL=radar@terceraletra.cl
